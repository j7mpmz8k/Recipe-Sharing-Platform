<div class="home-container">
    <section class="hero-section">
        <h1>Share & Discover Delicious Recipes</h1>
        <p class="hero-subtitle">
            Explore top-rated dishes, save your favorites, and share your own culinary creations with fellow food lovers.
        </p>
        <div class="hero-actions">
            <a href="/recipes" class="btn btn-primary">Browse All Recipes</a>
            {{#if user}}
                <a href="/recipes/new" class="btn btn-secondary">Post a Recipe</a>
            {{else}}
                <a href="/register" class="btn btn-secondary">Create an Account</a>
            {{/if}}
        </div>
    </section>

    <section class="featured-section">
        <div class="section-header">
            <h2>Featured Recipes</h2>
            <a href="/recipes" class="view-all-link">View all &rarr;</a>
        </div>

        {{#if recipes.length}}
            <div class="recipe-grid">
                {{#each recipes}}
                    <article class="recipe-card">
                        <div class="recipe-card-body">
                            <h3 class="recipe-title">
                                <a href="/recipes/{{#if this.recipeId}}{{this.recipeId}}{{else}}{{this.id}}{{/if}}">{{this.title}}</a>
                            </h3>
                            <p class="recipe-author">
                                By <a href="/users/{{#if this.userId}}{{this.userId}}{{else}}{{this.user_id}}{{/if}}">{{#if this.authorName}}{{this.authorName}}{{else}}{{this.username}}{{/if}}</a>
                            </p>
                            {{#if this.description}}
                                <p class="recipe-description">{{this.description}}</p>
                            {{/if}}
                            <div class="recipe-meta">
                                <div class="recipe-meta-badges">
                                    {{#if this.prepTime}}
                                        <span>⏱ {{this.prepTime}}m prep</span>
                                    {{else if this.prep_time}}
                                        <span>⏱ {{this.prep_time}}m prep</span>
                                    {{/if}}
                                    {{#if this.cooktime}}
                                        <span>🕒 {{this.cooktime}}m cook</span>
                                    {{else if this.cook_time}}
                                        <span>🕒 {{this.cook_time}}m cook</span>
                                    {{/if}}
                                    {{#if this.servings}}
                                        <span>🍽 {{this.servings}} servings</span>
                                    {{/if}}
                                </div>
                            </div>
                        </div>
                        <div class="recipe-card-footer">
                            {{#if ../user}}
                                <button type="button" class="btn-link favorite-btn {{#if this.isFavorite}}favorited{{else if this.isFavorited}}favorited{{/if}}" data-recipe-id="{{#if this.recipeId}}{{this.recipeId}}{{else}}{{this.id}}{{/if}}" style="font-size: 1.1rem; padding: 0.1rem 0.35rem; line-height: 1; cursor: pointer; background: none; border: none;" title="{{#if this.isFavorite}}Unfavorite this recipe{{else if this.isFavorited}}Unfavorite this recipe{{else}}Favorite this recipe{{/if}}">
                                    <span class="heart-icon">{{#if this.isFavorite}}❤️{{else if this.isFavorited}}❤️{{else}}🤍{{/if}}</span>
                                    <span class="favorite-count">{{#if this.favCount}}{{this.favCount}}{{else}}0{{/if}}</span>
                                </button>
                            {{else}}
                                <span class="favorites-display">
                                    <span class="heart-icon">❤️</span>
                                    <span class="favorite-count">{{#if this.favCount}}{{this.favCount}}{{else}}0{{/if}}</span>
                                </span>
                            {{/if}}
                            <div class="card-footer-actions">
                                {{#if this.canEdit}}
                                    <a href="/recipes/{{#if this.recipeId}}{{this.recipeId}}{{else}}{{this.id}}{{/if}}/edit" class="btn-text btn-text-edit">✏️ Edit</a>
                                {{/if}}
                                <a href="/recipes/{{#if this.recipeId}}{{this.recipeId}}{{else}}{{this.id}}{{/if}}" class="btn-text">View Recipe &rarr;</a>
                            </div>
                        </div>
                    </article>
                {{/each}}
            </div>
        {{else}}
            <div class="empty-state">
                <p>No featured recipes found yet.</p>
                {{#if user}}
                    <a href="/recipes/new" class="btn btn-primary">Share the First Recipe</a>
                {{else}}
                    <a href="/recipes" class="btn btn-primary">Browse All Recipes</a>
                {{/if}}
            </div>
        {{/if}}
    </section>
</div>
