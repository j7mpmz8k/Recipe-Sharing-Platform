<!-- views/layouts/main.hbs -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}{{#if title}} - {{/if}}Recipe Sharing Platform</title>
    <link rel="stylesheet" href="/styles.css?v=1.4">
    <script src="/js/app.js" defer></script>
</head>
<body>
    <nav>
        <div class="nav-left">
            <a href="/" class="nav-brand">🍽 RecipeShare</a>
            <div class="nav-links">
                <a href="/recipes">Recipes</a>
                {{#if user}}
                    <a href="/my-recipes">My Recipes</a>
                    <a href="/favorites">Favorites</a>
                {{/if}}
            </div>
        </div>
        <div class="nav-right">
            <span class="online-status-badge">
                <span class="online-dot"></span>
                <span id="online-count-text">{{onlineCount}} online</span>
            </span>
            {{#if user}}
                <div class="nav-user-dropdown" id="navUserDropdown">
                    <button type="button" class="nav-user-btn" id="userMenuBtn" aria-expanded="false" aria-haspopup="true">
                        <span class="nav-user-name">{{#if user.first_name}}{{user.first_name}}{{else}}{{user.username}}{{/if}}</span>
                        <span class="dropdown-arrow">▾</span>
                    </button>
                    <div class="nav-dropdown-menu" id="userDropdownMenu">
                        <div class="dropdown-header">
                            Signed in as <strong>{{#if user.first_name}}{{user.first_name}}{{else}}{{user.username}}{{/if}}</strong>
                        </div>
                        <a href="/users/{{user.id}}" class="dropdown-item">👤 My Profile</a>
                        <a href="/change-password" class="dropdown-item">🔑 Change Password</a>
                        {{#if user.isAdmin}}
                            <a href="/admin" class="dropdown-item admin-item">👑 Admin Dashboard</a>
                        {{/if}}
                        <div class="dropdown-divider"></div>
                        <form action="/logout" method="POST" class="logout-form">
                            <button type="submit" class="dropdown-item logout-item">🚪 Logout</button>
                        </form>
                    </div>
                </div>
            {{else}}
                <a href="/login">Login</a>
                <a href="/register">Register</a>
            {{/if}}
        </div>
    </nav>

    {{#if siteBanner.isActive}}
        <div class="site-announcement-banner site-banner-{{siteBanner.bannerType}}" role="alert">
            {{#if siteBanner.isWarning}}<span>⚠️</span>{{/if}}
            {{#if siteBanner.isAlert}}<span>🚨</span>{{/if}}
            {{#if siteBanner.isInfo}}<span>ℹ️</span>{{/if}}
            {{#if siteBanner.isSuccess}}<span>📢</span>{{/if}}
            <span>{{siteBanner.message}}</span>
        </div>
    {{/if}}

    <main>
        {{{body}}}
    </main>

    <footer>
        <p class="footer-donate-text">
            ☕ Enjoying the site? Please consider supporting on Venmo: <a href="https://venmo.com/u/Jacob-Cardon" target="_blank" rel="noopener noreferrer" class="footer-donate-link">@Jacob-Cardon</a>
        </p>
        <p class="footer-contact-text">
            ✉️ Questions, feedback, or invite requests? <a href="mailto:contact@recipes.jcardon.me" class="footer-contact-link">contact@recipes.jcardon.me</a>
        </p>
    </footer>
</body>
</html>
