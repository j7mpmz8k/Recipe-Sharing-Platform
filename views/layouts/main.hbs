<!-- views/layouts/main.hbs -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}{{#if title}} - {{/if}}Recipe Sharing Platform</title>
    <link rel="stylesheet" href="/styles.css">
    <script src="/js/favorites.js" defer></script>
</head>
<body>
    <nav>
        <div class="nav-left">
            <a href="/" class="nav-brand">🍽 RecipeShare</a>
            <a href="/">Home</a>
            <a href="/recipes">Recipes</a>
            {{#if user}}
                <a href="/my-recipes">My Recipes</a>
                <a href="/favorites">Favorites</a>
                {{#if user.isAdmin}}
                    <a href="/admin/invites" style="color: #d97706; font-weight: 600;">👑 Admin Invites</a>
                {{/if}}
            {{/if}}
        </div>
        <div class="nav-right">
            {{#if user}}
                <span class="nav-user">Welcome, <a href="/users/{{user.id}}">{{user.username}}</a></span>
                <form action="/logout" method="POST" class="logout-form">
                    <button type="submit" class="btn-link">Logout</button>
                </form>
            {{else}}
                <a href="/login">Login</a>
                <a href="/register">Register</a>
            {{/if}}
        </div>
    </nav>

    <main>
        {{{body}}}
    </main>

    <footer>
        <div style="display: flex; justify-content: center; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
            <span>© 2026 Recipe Sharing Platform</span>
            <span style="color: var(--card-border, #cbd5e0);">•</span>
            <span class="online-status-badge" style="display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.85rem; font-weight: 500; color: #16a34a; background: #dcfce7; padding: 0.2rem 0.6rem; border-radius: 9999px;">
                <span style="display: inline-block; width: 7px; height: 7px; background-color: #22c55e; border-radius: 50%; box-shadow: 0 0 4px #22c55e;"></span>
                <span>{{onlineCount}} online</span>
            </span>
        </div>
        <p class="donate-text" style="margin-top: 0.5rem; font-size: 0.85rem; color: var(--text-muted, #718096);">
            ☕ Enjoying the site? Please consider donating to support the website on Venmo: <strong>@Jacob-Cardon</strong>
        </p>
    </footer>
</body>
</html>
