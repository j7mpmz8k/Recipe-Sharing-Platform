<div class="user-profile-container profile-container">
    <!-- Profile Header Card -->
    <header class="recipe-header-card profile-header-card">
        <div class="profile-user-info">
            <div class="avatar-circle profile-avatar">
                👤
            </div>
            <div>
                <h1 class="profile-name">{{#if userProfile.first_name}}{{userProfile.first_name}}{{#if userProfile.last_name}} {{userProfile.last_name}}{{/if}}{{else}}{{userProfile.username}}{{/if}}</h1>
                <p class="text-muted profile-joined">
                    Member since {{userProfile.createdAt}}
                </p>
                {{#if user}}
                    <p class="text-muted profile-email-row">
                        <span>✉️</span>
                        <a href="mailto:{{userProfile.email}}" class="profile-email-link">{{userProfile.email}}</a>
                        <button 
                            type="button" 
                            class="btn btn-secondary profile-copy-email-btn" 
                            data-copy-text="{{userProfile.email}}"
                            data-copied-text="Copied!"
                            title="Copy email to clipboard"
                        >📋 Copy</button>
                    </p>
                {{/if}}
            </div>
        </div>

        <div class="profile-stat-box">
            <span class="profile-stat-number">
                {{#if userProfile.recipes.length}}{{userProfile.recipes.length}}{{else}}0{{/if}}
            </span>
            <span class="profile-stat-label">
                🍳 Recipes Shared
            </span>
        </div>
    </header>

    {{#if passwordSuccess}}
        <div class="alert alert-success">
            {{passwordSuccess}}
        </div>
    {{/if}}

    <!-- User's Recipes Grid -->
    <section>
        <div class="section-header">
            <h2 class="profile-recipes-heading">Recipes by {{#if userProfile.first_name}}{{userProfile.first_name}}{{else}}{{userProfile.username}}{{/if}}</h2>
        </div>

        {{#if userProfile.recipes.length}}
            <div class="recipe-grid">
                {{#each userProfile.recipes}}
                    <article class="recipe-card">
                        <div class="recipe-card-body">
                            <h3 class="recipe-title">
                                <a href="/recipes/{{#if this.recipeId}}{{this.recipeId}}{{else}}{{this.id}}{{/if}}">{{this.title}}</a>
                            </h3>
                            <p class="recipe-author">
                                By <a href="/users/{{#if this.userId}}{{this.userId}}{{else}}{{this.user_id}}{{/if}}">{{#if this.authorName}}{{this.authorName}}{{else}}{{this.username}}{{/if}}</a>
                            </p>
                            {{#if this.description}}
                                <p class="recipe-description">{{this.description}}</p>
                            {{/if}}
                            <div class="recipe-meta">
                                <div class="recipe-meta-badges">
                                    {{#if this.prepTime}}
                                        <span>⏱ {{this.prepTime}}m prep</span>
                                    {{else if this.prep_time}}
                                        <span>⏱ {{this.prep_time}}m prep</span>
                                    {{/if}}
                                    {{#if this.cookTime}}
                                        <span>🕒 {{this.cookTime}}m cook</span>
                                    {{else if this.cook_time}}
                                        <span>🕒 {{this.cook_time}}m cook</span>
                                    {{/if}}
                                    {{#if this.servings}}
                                        <span title="{{this.servings}} servings">🍽 {{this.servings}}</span>
                                    {{/if}}
                                </div>
                            </div>
                        </div>
                        <div class="recipe-card-footer">
                            <div class="card-footer-left">
                                <button type="button" class="btn-link share-card-btn" data-action="copy-share" data-title="{{this.title}}" data-author="{{#if this.authorName}}{{this.authorName}}{{else}}{{this.username}}{{/if}}" data-url="/recipes/{{#if this.recipeId}}{{this.recipeId}}{{else}}{{this.id}}{{/if}}" title="Copy shareable link">🔗</button>
                                {{#if @root.user}}
                                    <button type="button" class="btn-link favorite-btn {{#if this.isFavorite}}favorited{{else if this.isFavorited}}favorited{{/if}}" data-recipe-id="{{#if this.recipeId}}{{this.recipeId}}{{else}}{{this.id}}{{/if}}" title="{{#if this.isFavorite}}Unfavorite this recipe{{else if this.isFavorited}}Unfavorite this recipe{{else}}Favorite this recipe{{/if}}">
                                        <span class="heart-icon">{{#if this.isFavorite}}❤️{{else if this.isFavorited}}❤️{{else}}🤍{{/if}}</span>
                                        <span class="favorite-count">{{#if this.favCount}}{{this.favCount}}{{else}}0{{/if}}</span>
                                    </button>
                                {{else}}
                                    <span class="favorites-display" title="Log in to favorite recipes">
                                        <span class="heart-icon">🤍</span>
                                        <span class="favorite-count">{{#if this.favCount}}{{this.favCount}}{{else}}0{{/if}}</span>
                                    </span>
                                {{/if}}
                            </div>
                            <div class="card-footer-actions">
                                {{#if this.canEdit}}
                                    <a href="/recipes/{{#if this.recipeId}}{{this.recipeId}}{{else}}{{this.id}}{{/if}}/edit" class="btn-text btn-text-edit">✏️ Edit</a>
                                {{/if}}
                                <a href="/recipes/{{#if this.recipeId}}{{this.recipeId}}{{else}}{{this.id}}{{/if}}" class="btn-text">View Recipe &rarr;</a>
                            </div>
                        </div>
                    </article>
                {{/each}}
            </div>
        {{else}}
            <div class="empty-state">
                <p>No recipes posted yet.</p>
            </div>
        {{/if}}
    </section>
</div>
