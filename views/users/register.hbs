<div class="auth-container">
    <div class="auth-card">
        {{#if inviteOnly}}
            <h2>Invite-Only Community</h2>
            <div class="invite-notice" style="margin: 1.5rem 0; text-align: center;">
                <div style="font-size: 3rem; margin-bottom: 1rem;">🔒</div>
                <p style="font-size: 1.05rem; line-height: 1.6; color: var(--text-secondary); margin-bottom: 1.25rem;">
                    Registration on RecipeShare is private and currently <strong>invite-only</strong>.
                </p>

                {{#if error}}
                    <div class="alert alert-error" style="text-align: left; margin-bottom: 1.25rem;">
                        {{error}}
                    </div>
                {{/if}}

                <div style="background-color: var(--card-footer-bg, #f7fafc); border: 1px solid var(--card-border, #e2e8f0); border-radius: 8px; padding: 1.25rem; margin-bottom: 1.5rem;">
                    <p style="margin-bottom: 0.5rem; font-weight: 600; color: var(--text-primary);">
                        Want to join us?
                    </p>
                    <p style="margin-bottom: 0.75rem; font-size: 0.95rem; color: var(--text-muted);">
                        Please reach out to our admin to request an invitation link:
                    </p>
                    <a href="mailto:{{contactEmail}}?subject=RecipeShare%20Invite%20Request" class="btn btn-primary" style="display: inline-block; padding: 0.65rem 1.25rem; text-decoration: none;">
                        ✉️ {{contactEmail}}
                    </a>
                </div>
            </div>

            <p class="auth-switch">
                Already have an account? <a href="/login">Log in</a>
            </p>
        {{else}}
            <h2>Create Your Account</h2>
            <p style="font-size: 0.95rem; color: var(--text-muted); margin-bottom: 1.5rem;">
                Welcome! Complete the form below to activate your invitation.
            </p>

            {{#if error}}
                <div class="alert alert-error">
                    {{error}}
                </div>
            {{/if}}

            <form action="/register" method="POST" class="auth-form">
                <input type="hidden" name="token" value="{{token}}">

                <div class="form-group">
                    <label for="email">Invited Email</label>
                    <input 
                        type="email" 
                        id="email" 
                        name="email" 
                        value="{{email}}"
                        readonly
                        style="background-color: var(--card-footer-bg, #f7fafc); cursor: not-allowed;"
                    >
                    <small style="color: var(--text-muted); font-size: 0.8rem;">This invite was issued specifically for this email address.</small>
                </div>

                <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
                    <div class="form-group" style="flex: 1; min-width: 140px;">
                        <label for="first_name">First Name</label>
                        <input 
                            type="text" 
                            id="first_name" 
                            name="first_name" 
                            placeholder="e.g. John" 
                            value="{{first_name}}"
                            required
                            autocomplete="given-name"
                        >
                    </div>
                    <div class="form-group" style="flex: 1; min-width: 140px;">
                        <label for="last_name">Last Name <small style="color: var(--text-muted);">(optional)</small></label>
                        <input 
                            type="text" 
                            id="last_name" 
                            name="last_name" 
                            placeholder="e.g. Doe" 
                            value="{{last_name}}"
                            autocomplete="family-name"
                        >
                    </div>
                </div>

                <div class="form-group">
                    <label for="username">Username (Login ID)</label>
                    <input 
                        type="text" 
                        id="username" 
                        name="username" 
                        placeholder="Choose a username" 
                        value="{{username}}"
                        required
                        minlength="3"
                        autocomplete="username"
                    >
                    <small style="color: var(--text-muted); font-size: 0.8rem;">Your username is private and only used to log in. Other members will see your first name.</small>
                </div>

                <div class="form-group">
                    <label for="password">Password (at least 12 characters)</label>
                    <input 
                        type="password" 
                        id="password" 
                        name="password" 
                        placeholder="Create a password" 
                        required
                        autocomplete="new-password"
                        minlength="12"
                    >
                </div>

                <div class="form-group">
                    <label for="confirmPassword">Confirm Password</label>
                    <input 
                        type="password" 
                        id="confirmPassword" 
                        name="confirmPassword" 
                        placeholder="Confirm your password" 
                        required
                        autocomplete="new-password"
                        minlength="12"
                    >
                </div>

                <button type="submit" class="btn btn-primary">Complete Registration</button>
            </form>

            <p class="auth-switch">
                Already have an account? <a href="/login">Log in</a>
            </p>
        {{/if}}
    </div>
</div>
