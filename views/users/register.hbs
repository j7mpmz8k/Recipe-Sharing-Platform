<div class="auth-container">
    <div class="auth-card">
        {{#if inviteOnly}}
            <h2>Invite-Only Community</h2>
            <div class="invite-notice register-invite-notice">
                <div class="register-lock-icon">🔒</div>
                <p class="register-notice-text">
                    Registration on RecipeShare is private and currently <strong>invite-only</strong>.
                </p>

                {{#if error}}
                    <div class="alert alert-error auth-alert-spaced">
                        {{error}}
                    </div>
                {{/if}}

                <div class="register-info-box">
                    <p class="register-info-title">
                        Want to join us?
                    </p>
                    <p class="register-info-desc">
                        Please reach out to our admin to request an invitation link:
                    </p>
                    <a href="mailto:{{contactEmail}}?subject=RecipeShare%20Invite%20Request" class="btn btn-primary register-request-btn">
                        ✉️ {{contactEmail}}
                    </a>
                </div>
            </div>

            <p class="auth-switch">
                Already have an account? <a href="/login">Log in</a>
            </p>
        {{else}}
            <h2>Create Your Account</h2>
            <p class="auth-card-subtitle">
                Welcome! Complete the form below to activate your invitation.
            </p>

            {{#if error}}
                <div class="alert alert-error">
                    {{error}}
                </div>
            {{/if}}

            <form action="/register" method="POST" class="auth-form">
                <input type="hidden" name="token" value="{{token}}">

                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input 
                        type="email" 
                        id="email" 
                        name="email" 
                        placeholder="you@example.com" 
                        value="{{email}}"
                        required
                        autocomplete="email"
                    >
                    <small class="text-muted-sm">Used for account recovery and notifications.</small>
                </div>

                <div class="register-names-row">
                    <div class="form-group register-name-field">
                        <label for="first_name">First Name</label>
                        <input 
                            type="text" 
                            id="first_name" 
                            name="first_name" 
                            placeholder="e.g. John" 
                            value="{{first_name}}"
                            required
                            autocomplete="given-name"
                        >
                    </div>
                    <div class="form-group register-name-field">
                        <label for="last_name">Last Name <small class="text-muted">(optional)</small></label>
                        <input 
                            type="text" 
                            id="last_name" 
                            name="last_name" 
                            placeholder="e.g. Doe" 
                            value="{{last_name}}"
                            autocomplete="family-name"
                        >
                    </div>
                </div>

                <div class="form-group">
                    <label for="username">Username (Login ID)</label>
                    <input 
                        type="text" 
                        id="username" 
                        name="username" 
                        placeholder="Choose a username" 
                        value="{{username}}"
                        required
                        minlength="3"
                        autocomplete="username"
                    >
                    <small class="text-muted-sm">Your username is private and only used to log in. Other members will see your first name.</small>
                </div>

                <div class="form-group">
                    <label for="password">Password (at least 12 characters)</label>
                    <input 
                        type="password" 
                        id="password" 
                        name="password" 
                        placeholder="Create a password" 
                        required
                        autocomplete="new-password"
                        minlength="12"
                    >
                </div>

                <div class="form-group">
                    <label for="confirmPassword">Confirm Password</label>
                    <input 
                        type="password" 
                        id="confirmPassword" 
                        name="confirmPassword" 
                        placeholder="Confirm your password" 
                        required
                        autocomplete="new-password"
                        minlength="12"
                    >
                </div>

                <button type="submit" class="btn btn-primary">Complete Registration</button>
            </form>

            <p class="auth-switch">
                Already have an account? <a href="/login">Log in</a>
            </p>
        {{/if}}
    </div>
</div>
