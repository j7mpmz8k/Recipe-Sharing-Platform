<link rel="stylesheet" href="/admin.css">

<div class="recipes-container admin-container admin-container-narrow">
    <div class="section-header admin-header">
        <div>
            <h1 class="admin-title">
                <span>🔑</span> Admin: Member Invitations
            </h1>
            <p class="section-subtitle admin-subtitle">
                Manage and issue private invitation links for friends and family. Only registered invitees can create an account.
            </p>
        </div>
    </div>

    {{#if error}}
        <div class="alert alert-error admin-alert-spaced">
            {{error}}
        </div>
    {{/if}}

    {{#if success}}
        <div class="alert alert-success admin-alert-box">
            <p class="admin-alert-box-title">{{success}}</p>
            <div>
                <label for="inviteLinkInput" class="admin-field-label">
                    Share this unique registration link with your guest:
                </label>
                <div class="admin-input-row">
                    <input 
                        type="text" 
                        id="inviteLinkInput" 
                        value="{{inviteUrl}}" 
                        readonly 
                        class="admin-input-copyable"
                    >
                    <button 
                        type="button" 
                        class="btn btn-primary admin-copy-btn" 
                        data-copy-target="inviteLinkInput"
                        data-copied-text="Copied!"
                    >
                        📋 Copy Link
                    </button>
                </div>
                <small class="admin-hint-text">
                    ⏳ This temporary link is valid for 48 hours and automatically becomes invalid once used.
                </small>
            </div>
        </div>
    {{/if}}

    <!-- Generate Invite Form Card -->
    <div class="admin-card">
        <h2 class="admin-card-title">Issue a New Invitation</h2>
        <p class="admin-card-desc">
            Enter the email address of the person you want to invite.
        </p>

        <form action="/admin/invites" method="POST" class="admin-form-row">
            <input 
                type="email" 
                name="email" 
                placeholder="friend@example.com" 
                required 
                class="admin-input-flex"
            >
            <button type="submit" class="btn btn-primary admin-btn-action">
                ✉️ Create Invite Link
            </button>
        </form>
    </div>

    <!-- Invites History Card -->
    <div class="admin-card">
        <h2 class="admin-card-title">Invitation History</h2>

        {{#if invites.length}}
            <div class="admin-table-wrapper">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Email</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Expires</th>
                            <th class="admin-table-right">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each invites}}
                            <tr>
                                <td>
                                    <strong>{{this.email}}</strong>
                                </td>
                                <td>
                                    <span class="status-badge {{#if this.isActive}}status-badge-active{{/if}}{{#if this.isUsed}}status-badge-used{{/if}}{{#if this.isExpired}}status-badge-expired{{/if}}">
                                        {{this.status}}
                                    </span>
                                </td>
                                <td class="text-muted">
                                    {{this.createdAt}}
                                </td>
                                <td class="text-muted">
                                    {{this.expiresAt}}
                                </td>
                                <td class="admin-table-right">
                                    {{#if this.isUsable}}
                                        <button 
                                            type="button" 
                                            class="btn btn-secondary admin-btn-sm" 
                                            data-copy-text="{{@root.baseUrl}}/register?token={{this.token}}"
                                            data-copied-text="Copied!"
                                            title="Copy registration link"
                                        >
                                            📋 Copy
                                        </button>
                                    {{else}}
                                        <span class="text-muted">-</span>
                                    {{/if}}
                                </td>
                            </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        {{else}}
            <p class="text-muted admin-empty-message">
                No invitations have been generated yet. Use the form above to invite your first member!
            </p>
        {{/if}}
    </div>
</div>
