<link rel="stylesheet" href="/admin.css">
<div class="recipes-container admin-container">
    <!-- Admin Header -->
    <div class="section-header admin-header">
        <div>
            <h1 class="admin-title">
                <span>👑</span> Admin Control Center
            </h1>
            <p class="section-subtitle admin-subtitle">
                Monitor online users, manage member access, broadcast announcement banners, and generate credentials.
            </p>
        </div>
    </div>

    <!-- Alert Notifications -->
    {{#if error}}
        <div class="alert alert-error admin-alert-spaced">
            {{error}}
        </div>
    {{/if}}

    {{#if actionSuccess}}
        <div class="alert alert-success admin-alert-spaced">
            {{actionSuccess}}
        </div>
    {{/if}}

    {{#if bannerSuccess}}
        <div class="alert alert-success admin-alert-spaced">
            {{bannerSuccess}}
        </div>
    {{/if}}

    {{#if resetSuccess}}
        <div class="alert alert-success admin-alert-box">
            <p class="admin-alert-box-title">🔑 {{resetSuccess}}</p>
            <div>
                <label for="resetLinkInput" class="admin-field-label">
                    Send this one-time password reset link to the user:
                </label>
                <div class="admin-input-row">
                    <input 
                        type="text" 
                        id="resetLinkInput" 
                        value="{{resetUrl}}" 
                        readonly 
                        class="admin-input-copyable"
                    >
                    <button type="button" class="btn btn-primary admin-copy-btn" data-copy-target="resetLinkInput" data-copied-text="Copied!">
                        📋 Copy Link
                    </button>
                </div>
                <small class="admin-hint-text">
                    ⏳ This password reset link expires in 48 hours and can only be used once.
                </small>
            </div>
        </div>
    {{/if}}

    {{#if inviteSuccess}}
        <div class="alert alert-success admin-alert-box">
            <p class="admin-alert-box-title">✉️ {{inviteSuccess}}</p>
            <div>
                <label for="inviteLinkInput" class="admin-field-label">
                    Share this unique registration link with your invited guest:
                </label>
                <div class="admin-input-row">
                    <input 
                        type="text" 
                        id="inviteLinkInput" 
                        value="{{inviteUrl}}" 
                        readonly 
                        class="admin-input-copyable"
                    >
                    <button type="button" class="btn btn-primary admin-copy-btn" data-copy-target="inviteLinkInput" data-copied-text="Copied!">
                        📋 Copy Link
                    </button>
                </div>
                <small class="admin-hint-text">
                    ⏳ This invite link expires in 48 hours and becomes invalid once an account is registered.
                </small>
            </div>
        </div>
    {{/if}}

<!-- Stat Metric Cards -->
    <div class="admin-metrics-grid">
        <div class="admin-metric-card">
            <div class="admin-metric-title">Registered Users</div>
            <div id="stat-total-users" class="admin-metric-value">{{totalUsers}}</div>
        </div>
        <div class="admin-metric-card">
            <div class="admin-metric-title">Visitors Online</div>
            <div class="admin-metric-value-green"><span class="admin-status-dot-green"></span><span id="stat-online-count">{{onlineCount}}</span>
            </div>
        </div>
        <div class="admin-metric-card">
            <div class="admin-metric-title">Online Members</div>
            <div class="admin-metric-value-blue"><span class="admin-metric-icon">👥</span><span id="stat-online-users">{{onlineUsersCount}}</span>
            </div>
        </div>
        <div class="admin-metric-card">
            <div class="admin-metric-title">Active Guests</div>
            <div class="admin-metric-value-cyan"><span class="admin-metric-icon">🌐</span><span id="stat-active-guests">{{activeGuestsCount}}</span>
            </div>
        </div>
        <div class="admin-metric-card">
            <div class="admin-metric-title">Rate-Limited</div>
            <div id="stat-rate-limited" class="admin-metric-value admin-metric-value-red">{{rateLimitedCount}}</div>
        </div>
        <div class="admin-metric-card">
            <div class="admin-metric-title">Invites Issued</div>
            <div id="stat-total-invites" class="admin-metric-value">{{invites.length}}</div>
        </div>
    </div>

    <!-- Section 1: Community Members -->
    <div class="admin-card">
        <h2 class="admin-card-title">
            <span>👥</span> Community Members
        </h2>
        <p class="admin-card-desc">
            Real-time online status (active in the last 5 minutes), last activity timestamp, username management, and moderation controls.
        </p>

        <div class="admin-table-wrapper">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>User</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th>Last Active</th>
                        <th>Joined</th>
                        <th class="admin-table-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each users}}
                        <tr id="user-row-{{this.id}}">
                            <td class="admin-user-id">
                                #{{this.id}}
                            </td>
                            <td>
                                <a href="/users/{{this.id}}" class="admin-user-link">
                                    {{#if this.firstName}}{{this.firstName}}{{#if this.lastName}} {{this.lastName}}{{/if}}{{else}}{{this.username}}{{/if}}
                                </a>
                                <span class="admin-user-username">
                                    (@{{this.username}})
                                </span>
                                {{#if this.isAdmin}}
                                    <span class="admin-badge-admin">
                                        ADMIN
                                    </span>
                                {{/if}}
                                <button type="button" class="btn-text admin-btn-edit-user" data-action="open-edit-user" data-user-id="{{this.id}}" data-username="{{this.username}}" data-first-name="{{this.firstName}}" data-last-name="{{this.lastName}}" title="Edit member profile">
                                    ✏️ Edit
                                </button>
                            </td>
                            <td>
                                {{this.email}}
                            </td>
                            <td id="user-status-{{this.id}}">
                                {{#if this.isBlocked}}
                                    <span class="admin-badge-suspended"><span class="admin-dot-sm admin-dot-red"></span> Suspended</span>
                                {{else}}
                                    {{#if this.isOnline}}
                                        <span class="admin-badge-online"><span class="admin-dot-sm admin-dot-green"></span> Online now</span>
                                    {{else}}
                                        <span class="admin-badge-offline"><span class="admin-dot-sm admin-dot-gray"></span> Offline</span>
                                    {{/if}}
                                {{/if}}
                            </td>
                            <td id="user-lastonline-{{this.id}}" class="admin-user-cell-muted">
                                {{this.lastOnline}}
                            </td>
                            <td class="admin-user-cell-muted">
                                {{this.createdAt}}
                            </td>
                            <td class="admin-table-right">
                                <div class="admin-table-actions">
                                    {{#if this.isAdmin}}
                                        <span class="admin-user-protected">Protected</span>
                                    {{else}}
                                        <form action="/admin/users/{{this.id}}/delete" method="POST" class="admin-inline-form">
                                            <button type="submit" class="btn admin-btn-delete-user" data-confirm="WARNING: Are you sure you want to permanently delete user {{this.username}} and all their recipes? This cannot be undone.">
                                                🗑️ Delete
                                            </button>
                                        </form>
                                    {{/if}}

                                    <form action="/admin/users/{{this.id}}/reset-password" method="POST" class="admin-inline-form">
                                        <button type="submit" class="btn btn-secondary admin-btn-sm" data-confirm="Generate a temporary password reset link for {{this.username}}?">
                                            🔑 Reset Password
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>

    <!-- Section: Active Guest Visitors -->
    <div class="admin-card">
        <div class="admin-card-header">
            <h2 class="admin-card-title">
                <span>🌐</span> Active Guest Visitors (by IP)
            </h2>
            <span id="active-guests-badge" class="admin-badge-guests">
                {{activeGuestsCount}} Online (Last 3 Mins)
            </span>
        </div>
        <p class="admin-card-desc">
            Real-time anonymous visitors tracked by IP address. Logged-in users are automatically excluded to avoid double-counting.
        </p>

        {{#if activeGuests.length}}
            <div class="admin-table-wrapper">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>IP Address</th>
                            <th>Last Active</th>
                            <th>Current / Last Page</th>
                            <th>Device / OS</th>
                        </tr>
                    </thead>
                    <tbody id="guests-table-body">
                        {{#each activeGuests}}
                            <tr>
                                <td class="admin-guest-ip">
                                    {{this.ip}}
                                </td>
                                <td class="admin-guest-active">
                                    ● {{this.lastSeen}}
                                </td>
                                <td class="admin-guest-path">
                                    {{this.lastPath}}
                                </td>
                                <td class="text-muted">
                                    {{this.device}}
                                </td>
                            </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        {{else}}
            <p class="admin-hint-text">
                No anonymous guest visitors active in the last 3 minutes.
            </p>
        {{/if}}
    </div>

    <!-- Section: Live Traffic & Request Logs -->
    <div id="live-logs" class="admin-card">
        <div class="admin-card-header">
            <h2 class="admin-card-title">
                <span>📊</span> Live Traffic &amp; Request Logs
            </h2>
            <div class="admin-input-row">
                <span id="log-count-badge" class="admin-badge-logs">
                    Latest {{recentLogs.length}} Requests
                </span>
                <button type="button" class="btn btn-secondary admin-btn-sm" data-action="refresh-logs">
                    🔄 Refresh Logs
                </button>
            </div>
        </div>
        <p class="admin-card-desc">
            Real-time in-memory circular buffer of server requests (capped at 1,000 entries, zero database overhead).
        </p>

        <div class="admin-logs-scroll">
            <table class="admin-logs-table">
                <thead class="admin-logs-thead">
                    <tr class="text-muted">
                        <th>Time</th>
                        <th>Client IP</th>
                        <th>User</th>
                        <th>Method</th>
                        <th>Request Path</th>
                        <th>Status</th>
                        <th class="admin-table-right">Latency</th>
                    </tr>
                </thead>
                <tbody id="logs-table-body">
                    {{#if recentLogs.length}}
                        {{#each recentLogs}}
                            <tr class="admin-logs-row">
                                <td class="admin-logs-cell text-muted">
                                    {{this.time}}
                                </td>
                                <td class="admin-logs-cell admin-guest-ip">
                                    {{this.ip}}
                                </td>
                                <td class="admin-logs-cell">
                                    {{#if this.isUser}}
                                        <span class="admin-logs-user-badge">
                                            {{this.user}}
                                        </span>
                                    {{else}}
                                        <span class="text-muted">guest</span>
                                    {{/if}}
                                </td>
                                <td class="admin-logs-cell">
                                    <span class="{{#if this.isSuccess}}admin-method-success{{/if}}{{#if this.isRedirect}}admin-method-redirect{{/if}}{{#if this.isClientError}}admin-method-client-error{{/if}}{{#if this.isServerError}}admin-method-server-error{{/if}}">
                                        {{this.method}}
                                    </span>
                                </td>
                                <td class="admin-logs-path-cell">
                                    {{this.path}}
                                </td>
                                <td class="admin-logs-cell">
                                    <span title="{{this.statusHint}}" class="admin-logs-status-pill {{#if this.isSuccess}}status-badge-active{{/if}}{{#if this.isRedirect}}status-badge-used{{/if}}{{#if this.isClientError}}status-badge-admin{{/if}}{{#if this.isServerError}}status-badge-suspended{{/if}}">
                                        {{this.status}}
                                    </span>
                                </td>
                                <td class="admin-logs-cell admin-table-right text-muted">
                                    {{this.duration}}
                                </td>
                            </tr>
                        {{/each}}
                    {{else}}
                        <tr>
                            <td colspan="7" class="admin-empty-message text-muted">
                                No requests recorded in memory yet. Navigate around the site to populate live logs!
                            </td>
                        </tr>
                    {{/if}}
                </tbody>
            </table>
        </div>
    </div>

    <!-- Section: Site-Wide Announcement Banner -->
    <div class="admin-card">
        <div class="admin-card-header">
            <h2 class="admin-card-title">
                <span>📢</span> Site-Wide Announcement Banner
            </h2>
            {{#if banner.isActive}}
                <span class="admin-badge-banner-live">
                    ● LIVE ON SITE
                </span>
            {{else}}
                <span class="admin-badge-banner-inactive">
                    ○ INACTIVE
                </span>
            {{/if}}
        </div>
        <p class="admin-card-desc">
            Broadcast an urgent or informative notice across the top of all pages (e.g. <em>"Site shutdown in 1 hour for maintenance"</em>).
        </p>

        {{#if banner.isActive}}
            <div class="admin-banner-preview-box">
                <label class="admin-field-label-bold">Current Live Preview:</label>
                <div class="admin-banner-preview-pill {{#if banner.isWarning}}admin-banner-warning{{/if}}{{#if banner.isAlert}}admin-banner-alert{{/if}}{{#if banner.isInfo}}admin-banner-info{{/if}}{{#if banner.isSuccess}}admin-banner-success{{/if}}">
                    {{#if banner.isWarning}}⚠️{{/if}}
                    {{#if banner.isAlert}}🚨{{/if}}
                    {{#if banner.isInfo}}ℹ️{{/if}}
                    {{#if banner.isSuccess}}📢{{/if}}
                    {{banner.message}}
                </div>
            </div>
        {{/if}}

        <form action="/admin/banner" method="POST" class="admin-banner-form">
            <div>
                <label for="bannerMessage" class="admin-field-label-bold">
                    Banner Message
                </label>
                <input 
                    type="text" 
                    id="bannerMessage" 
                    name="message" 
                    value="{{banner.message}}" 
                    placeholder="e.g. Site shutdown in 1 hour for scheduled maintenance"
                    required
                    class="admin-input-standard"
                >
            </div>

            <div class="admin-form-row">
                <div>
                    <label for="bannerType" class="admin-field-label-bold">
                        Banner Style
                    </label>
                    <select id="bannerType" name="banner_type" class="admin-banner-select">
                        <option value="warning" {{#if banner.isWarning}}selected{{/if}}>⚠️ Warning / Shutdown (Yellow)</option>
                        <option value="alert" {{#if banner.isAlert}}selected{{/if}}>🚨 Urgent Alert (Red)</option>
                        <option value="info" {{#if banner.isInfo}}selected{{/if}}>ℹ️ Informational Notice (Blue)</option>
                        <option value="success" {{#if banner.isSuccess}}selected{{/if}}>📢 General Announcement (Green)</option>
                    </select>
                </div>

                <div class="admin-banner-checkbox-row">
                    <input 
                        type="checkbox" 
                        id="is_active" 
                        name="is_active" 
                        {{#if banner.isActive}}checked{{/if}} 
                        class="admin-checkbox-lg"
                    >
                    <label for="is_active" class="cursor-pointer">
                        Active (Visible across all site pages)
                    </label>
                </div>
            </div>

            <div class="admin-form-row">
                <button type="submit" class="btn btn-primary" class="admin-btn-action">
                    💾 Save &amp; Publish Banner
                </button>
            </div>
        </form>

        {{#if banner.isActive}}
            <form action="/admin/banner/disable" method="POST" class="mt-2">
                <button type="submit" class="btn btn-secondary" class="admin-btn-sm">
                    Disable Banner
                </button>
            </form>
        {{/if}}
    </div>

    <!-- Section 2: Account Invitations Form & Table -->
    <div id="invites" class="admin-card">
        <h2 class="admin-card-title">
            <span>✉️</span> Issue Account Invitation
        </h2>
        <p class="admin-card-desc">
            Generate temporary 48-hour registration links for friends and family. Add an optional name or reference note to track who hasn't accepted yet.
        </p>

        <!-- Dynamic inline toast alert for AJAX link generation -->
        <div id="invite-ajax-alert" class="admin-alert-spaced"></div>

        <form id="createInviteForm" action="/admin/invites" method="POST" class="admin-form-row admin-alert-spaced">
            <input 
                type="text" 
                id="inviteNameInput"
                name="name" 
                placeholder="Optional name / reference note (e.g. Mom, Dave, Book Club)" 
                class="admin-input-flex"
            >
            <button type="submit" id="generateInviteBtn" class="btn btn-primary" class="admin-btn-action">
                ➕ Generate Invite Link
            </button>
        </form>

        <div id="invites-table-wrapper" class="{{#unless invites.length}}hidden{{/unless}}">
            <h3 class="admin-field-label-bold">Invitations</h3>
            <div class="invites-scroll-container" class="admin-table-wrapper">
                <table class="invites-table admin-table">
                    <thead>
                        <tr>
                            <th>Reference / Note</th>
                            <th>Status</th>
                            <th>Accepted By</th>
                            <th>Created</th>
                            <th>Expires</th>
                            <th class="admin-table-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="invites-table-body">
                        {{#each invites}}
                            <tr id="invite-row-{{this.id}}">
                                <td><strong>
                                    {{this.name}}
                                </td>
                                <td>
                                    <span class="status-badge {{#if this.isActive}}status-badge-active{{/if}}{{#if this.isAccepted}}status-badge-used{{/if}}{{#if this.isUsed}}status-badge-used{{/if}}{{#if this.isExpired}}status-badge-expired{{/if}}">
                                        {{this.status}}
                                    </span>
                                </td>
                                <td>
                                    {{#if this.acceptedBy}}
                                        <div>{{this.acceptedBy}}</div>
                                        {{#if this.acceptedAt}}
                                            <div class="admin-hint-text">{{this.acceptedAt}}</div>
                                        {{/if}}
                                    {{else}}
                                        <span class="text-muted">-</span>
                                    {{/if}}
                                </td>
                                <td class="text-muted">{{this.createdAt}}</td>
                                <td class="text-muted">{{this.expiresAt}}</td>
                                <td class="admin-table-right">
                                    <div class="admin-table-actions">
                                        {{#if this.isUsable}}
                                            <button type="button" class="btn btn-secondary admin-btn-sm" data-action="copy-invite" data-url="{{@root.baseUrl}}/register?token={{this.token}}" title="Copy registration link">
                                                📋 Copy
                                            </button>
                                        {{/if}}
                                        <button type="button" class="btn-text admin-btn-delete-text" title="Delete this invite" data-action="delete-invite" data-invite-id="{{this.id}}">
                                            🗑️ Delete
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>
        <p id="invites-empty-notice" class="admin-hint-text {{#if invites.length}}hidden{{/if}}">
            No invitations created yet.
        </p>
    </div>

    <!-- Section 3: Password Resets History -->
    {{#if passwordResets.length}}
        <div class="admin-card">
            <h2 class="admin-card-title">
                <span>🔒</span> Generated Password Reset Links
            </h2>
            <p class="admin-card-desc">
                History of temporary reset tokens generated by admin.
            </p>

            <div class="admin-table-wrapper">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Email</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Expires</th>
                            <th class="admin-table-right">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each passwordResets}}
                            <tr>
                                <td><strong>{{this.username}}</td>
                                <td>{{this.email}}</td>
                                <td>
                                    <span class="status-badge {{#if this.isActive}}status-badge-active{{/if}}{{#if this.isAccepted}}status-badge-used{{/if}}{{#if this.isUsed}}status-badge-used{{/if}}{{#if this.isExpired}}status-badge-expired{{/if}}">
                                        {{this.status}}
                                    </span>
                                </td>
                                <td class="text-muted">{{this.createdAt}}</td>
                                <td class="text-muted">{{this.expiresAt}}</td>
                                <td class="admin-table-right">
                                    {{#if this.isUsable}}
                                        <a href="/reset-password?token={{this.token}}" class="btn-text" target="_blank">Reset Form ↗</a>
                                    {{else}}
                                        <span class="text-muted">-</span>
                                    {{/if}}
                                </td>
                            </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>
    {{/if}}

    <!-- Edit Member Profile Modal -->
    <div id="editUserModalBackdrop" class="admin-modal-backdrop">
        <div class="admin-modal-card">
            <div class="admin-modal-header">
                <h3 id="editUserModalTitle" class="admin-modal-title">Edit Member Profile</h3>
                <button type="button" class="admin-modal-close" data-action="close-modal">&times;</button>
            </div>
            <form id="editUserForm" method="POST" action="">
                <div class="admin-form-row">
                    <div class="flex-1">
                        <label for="edit_first_name" class="admin-field-label-bold">First Name</label>
                        <input type="text" id="edit_first_name" name="first_name" required class="admin-input-standard">
                    </div>
                    <div class="flex-1">
                        <label for="edit_last_name" class="admin-field-label-bold">Last Name <small class="text-muted font-normal">(optional)</small></label>
                        <input type="text" id="edit_last_name" name="last_name" class="admin-input-standard">
                    </div>
                </div>
                <div class="admin-banner-preview-box">
                    <label for="edit_username" class="admin-field-label-bold">Username (Login ID)</label>
                    <input type="text" id="edit_username" name="username" required minlength="3" class="admin-input-standard">
                    <small class="admin-hint-text">Usernames are private credentials used only for signing into the platform.</small>
                </div>
                <div class="admin-modal-footer">
                    <button type="button" class="btn btn-secondary" data-action="close-modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" class="admin-btn-action">Save Changes</button>
                </div>
            </form>
        </div>
    </div>

    <script src="/js/admin-dashboard.js" defer></script>
</div>
