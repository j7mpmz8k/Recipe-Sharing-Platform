<div class="auth-container recipe-form-container">
    <div class="auth-card">
        <h2>Edit Recipe</h2>

        {{#if error}}
            <div class="alert alert-error">{{error}}</div>
        {{/if}}

        <form id="edit-form" action="/recipes/{{#if recipe.recipeId}}{{recipe.recipeId}}{{else}}{{recipe.id}}{{/if}}" method="POST" class="auth-form">
            <div class="recipe-form-row">
                <div class="form-group recipe-form-group-flex">
                    <label for="title">Recipe Title *</label>
                    <input type="text" id="title" name="title" required placeholder="e.g. Grandma's Classic Lasagna" value="{{recipe.title}}">
                </div>

                <div class="form-group recipe-form-group-fixed">
                    <label for="category">Category</label>
                    <select id="category" name="category">
                        <option value="Breakfast" {{#if (eq recipe.category "Breakfast")}}selected{{/if}}>🍳 Breakfast</option>
                        <option value="Entree" {{#if (eq recipe.category "Entree")}}selected{{/if}}>🍲 Entrée</option>
                        <option value="Sides" {{#if (eq recipe.category "Sides")}}selected{{/if}}>🥗 Sides</option>
                        <option value="Desserts" {{#if (eq recipe.category "Desserts")}}selected{{/if}}>🍰 Desserts</option>
                        <option value="Drinks" {{#if (eq recipe.category "Drinks")}}selected{{/if}}>🍹 Drinks</option>
                        <option value="Other" {{#if (eq recipe.category "Other")}}selected{{else unless recipe.category}}selected{{/if}}>🍽️ Other</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label for="description">Short Description</label>
                <textarea id="description" name="description" rows="2" placeholder="Brief overview of the dish...">{{recipe.description}}</textarea>
            </div>

            <div class="recipe-form-row">
                <div class="recipe-meta-column">
                    <div class="form-group">
                        <label for="prep_time">Prep (mins)</label>
                        <input type="number" id="prep_time" name="prep_time" min="0" placeholder="15" value="{{#if recipe.prepTime}}{{recipe.prepTime}}{{/if}}">
                    </div>
                    <div class="form-group">
                        <label for="cook_time">Cook (mins)</label>
                        <input type="number" id="cook_time" name="cook_time" min="0" placeholder="30" value="{{#if recipe.cookTime}}{{recipe.cookTime}}{{/if}}">
                    </div>
                    <div class="form-group">
                        <label for="servings">Servings</label>
                        <input type="number" id="servings" name="servings" min="0" placeholder="4" value="{{#if recipe.servings}}{{recipe.servings}}{{/if}}">
                    </div>
                </div>

                <div class="form-group recipe-ingredients-column">
                    <label for="ingredients">Ingredients *</label>
                    <span class="form-hint">Enter each ingredient on a new line</span>
                    <textarea id="ingredients" name="ingredients" required placeholder="2 cups flour&#10;1 tsp salt&#10;3 eggs">{{recipe.ingredients}}</textarea>
                </div>
            </div>

            <div class="form-group">
                <label for="instructions">Instructions *</label>
                <span class="form-hint">Step-by-step cooking instructions</span>
                <textarea id="instructions" name="instructions" rows="8" required placeholder="1. Preheat the oven to 375°F...&#10;2. Mix dry ingredients...">{{recipe.instructions}}</textarea>
            </div>

            <div class="recipe-form-actions">
                <div class="recipe-form-actions-left">
                    <button type="submit" form="edit-form" class="btn btn-primary">Save Changes</button>
                    <a href="/recipes/{{#if recipe.recipeId}}{{recipe.recipeId}}{{else}}{{recipe.id}}{{/if}}" class="btn btn-secondary">Cancel</a>
                </div>
                <button type="submit" form="delete-form" class="btn btn-danger btn-sm">🗑️ Delete Recipe</button>
            </div>
        </form>

        <form id="delete-form" action="/recipes/{{#if recipe.recipeId}}{{recipe.recipeId}}{{else}}{{recipe.id}}{{/if}}/delete" method="POST" data-confirm="Are you sure you want to delete this recipe? This cannot be undone." class="hidden"></form>
    </div>
</div>
