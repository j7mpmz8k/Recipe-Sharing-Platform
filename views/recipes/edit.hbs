<div class="auth-container" style="max-width: 820px;">
    <div class="auth-card" style="padding: 2rem 2.25rem;">
        <h2>Edit Recipe</h2>

        {{#if error}}
            <div class="alert alert-error">{{error}}</div>
        {{/if}}

        <form id="edit-form" action="/recipes/{{#if recipe.recipeId}}{{recipe.recipeId}}{{else}}{{recipe.id}}{{/if}}" method="POST" class="auth-form" style="gap: 0.9rem;">
            <div class="form-group">
                <label for="title">Recipe Title *</label>
                <input type="text" id="title" name="title" required value="{{recipe.title}}">
            </div>

            <div class="form-group">
                <label for="description">Short Description</label>
                <textarea id="description" name="description" rows="2">{{recipe.description}}</textarea>
            </div>

            <div class="form-grid-3">
                <div class="form-group">
                    <label for="prep_time">Prep (mins)</label>
                    <input type="number" id="prep_time" name="prep_time" min="0" value="{{#if recipe.prepTime}}{{recipe.prepTime}}{{else}}{{recipe.prep_time}}{{/if}}">
                </div>
                <div class="form-group">
                    <label for="cook_time">Cook (mins)</label>
                    <input type="number" id="cook_time" name="cook_time" min="0" value="{{#if recipe.cooktime}}{{recipe.cooktime}}{{else}}{{recipe.cook_time}}{{/if}}">
                </div>
                <div class="form-group">
                    <label for="servings">Servings</label>
                    <input type="number" id="servings" name="servings" min="1" value="{{recipe.servings}}">
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                <div class="form-group">
                    <label for="ingredients">Ingredients *</label>
                    <textarea id="ingredients" name="ingredients" rows="7" required>{{recipe.ingredients}}</textarea>
                </div>
                <div class="form-group">
                    <label for="instructions">Instructions *</label>
                    <textarea id="instructions" name="instructions" rows="7" required>{{recipe.instructions}}</textarea>
                </div>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-top: 0.5rem; padding-top: 0.75rem; border-top: 1px solid var(--card-border);">
                <div style="display: flex; gap: 0.75rem;">
                    <button type="submit" form="edit-form" class="btn btn-primary">Save Changes</button>
                    <button type="button" class="btn btn-secondary" onclick="window.history.length > 1 ? history.back() : window.location.href='/recipes/{{#if recipe.recipeId}}{{recipe.recipeId}}{{else}}{{recipe.id}}{{/if}}'">Cancel</button>
                </div>
                <button type="submit" form="delete-form" class="btn btn-danger btn-sm">🗑️ Delete Recipe</button>
            </div>
        </form>

        <form id="delete-form" action="/recipes/{{#if recipe.recipeId}}{{recipe.recipeId}}{{else}}{{recipe.id}}{{/if}}/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this recipe? This cannot be undone.');" style="display: none;"></form>
    </div>
</div>
