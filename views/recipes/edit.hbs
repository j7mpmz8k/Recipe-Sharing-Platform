<div class="auth-container" style="max-width: 650px;">
    <div class="auth-card">
        <h2>Edit Recipe</h2>

        {{#if error}}
            <div class="alert alert-error">{{error}}</div>
        {{/if}}

        <form action="/recipes/{{#if recipe.recipeId}}{{recipe.recipeId}}{{else}}{{recipe.id}}{{/if}}" method="POST" class="auth-form">
            <div class="form-group">
                <label for="title">Recipe Title *</label>
                <input type="text" id="title" name="title" required value="{{recipe.title}}">
            </div>

            <div class="form-group">
                <label for="description">Short Description</label>
                <textarea id="description" name="description" rows="2">{{recipe.description}}</textarea>
            </div>

            <div class="recipe-form-row">
                <div class="recipe-meta-column">
                    <div class="form-group">
                        <label for="prep_time">Prep (mins)</label>
                        <input type="number" id="prep_time" name="prep_time" min="0" value="{{#if recipe.prepTime}}{{recipe.prepTime}}{{else}}{{recipe.prep_time}}{{/if}}">
                    </div>
                    <div class="form-group">
                        <label for="cook_time">Cook (mins)</label>
                        <input type="number" id="cook_time" name="cook_time" min="0" value="{{#if recipe.cooktime}}{{recipe.cooktime}}{{else}}{{recipe.cook_time}}{{/if}}">
                    </div>
                    <div class="form-group">
                        <label for="servings">Servings</label>
                        <input type="number" id="servings" name="servings" min="1" value="{{recipe.servings}}">
                    </div>
                </div>

                <div class="form-group recipe-ingredients-column">
                    <label for="ingredients">Ingredients *</label>
                    <span class="form-hint">Enter each ingredient on a new line</span>
                    <textarea id="ingredients" name="ingredients" required>{{recipe.ingredients}}</textarea>
                </div>
            </div>

            <div class="form-group">
                <label for="instructions">Instructions *</label>
                <span class="form-hint">Step-by-step cooking instructions</span>
                <textarea id="instructions" name="instructions" rows="8" required>{{recipe.instructions}}</textarea>
            </div>

            <div style="display: flex; gap: 1rem; margin-top: 1rem;">
                <button type="submit" class="btn btn-primary" style="flex: 1;">Save Changes</button>
                <a href="/recipes/{{#if recipe.recipeId}}{{recipe.recipeId}}{{else}}{{recipe.id}}{{/if}}" class="btn btn-secondary">Cancel</a>
            </div>
        </form>

        <form action="/recipes/{{#if recipe.recipeId}}{{recipe.recipeId}}{{else}}{{recipe.id}}{{/if}}/delete" method="POST" style="margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--card-border); display: flex; justify-content: flex-end;" onsubmit="return confirm('Are you sure you want to delete this recipe? This cannot be undone.');">
            <button type="submit" class="btn btn-danger btn-sm">🗑️ Delete Recipe</button>
        </form>
    </div>
</div>
