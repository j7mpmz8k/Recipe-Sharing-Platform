<div class="recipes-container">
    <div class="section-header">
        <div>
            <h2>All Recipes</h2>
            <p class="section-subtitle">Discover community-tested culinary creations</p>
        </div>
        {{#if user}}
            <a href="/recipes/new" class="btn btn-primary">+ Post a Recipe</a>
        {{/if}}
    </div>

    <!-- Search Bar -->
    <div class="search-section">
        <form action="/recipes" method="GET" class="search-form" style="max-width: 780px; flex-wrap: wrap; justify-content: center; align-items: center;">
            <div class="category-filter-wrapper">
                {{#if categoryFilter}}
                    <a href="/recipes{{#if searchQuery}}?search={{searchQuery}}{{/if}}" class="btn btn-secondary category-reset-btn" title="Clear category filter">Reset Category ✕</a>
                {{/if}}
                <select name="category" onchange="this.form.submit()" class="category-filter-select" style="padding: 0.75rem 1rem; border-radius: 30px; border: 1px solid var(--input-border, #cbd5e0); background-color: var(--card-bg, #ffffff); color: var(--text-primary, #2c3e50); font-size: 0.95rem; font-weight: 500; cursor: pointer; outline: none;" title="Filter by category">
                    <option value="">All Categories</option>
                    <option value="Breakfast" {{#if (eq categoryFilter "Breakfast")}}selected{{/if}}>🍳 Breakfast</option>
                    <option value="Entree" {{#if (eq categoryFilter "Entree")}}selected{{/if}}>🍲 Entrée</option>
                    <option value="Sides" {{#if (eq categoryFilter "Sides")}}selected{{/if}}>🥗 Sides</option>
                    <option value="Desserts" {{#if (eq categoryFilter "Desserts")}}selected{{/if}}>🍰 Desserts</option>
                    <option value="Drinks" {{#if (eq categoryFilter "Drinks")}}selected{{/if}}>🍹 Drinks</option>
                    <option value="Other" {{#if (eq categoryFilter "Other")}}selected{{/if}}>🍽️ Other</option>
                </select>
            </div>
            <div class="search-input-wrapper" style="min-width: 250px;">
                <span class="search-icon">🔍</span>
                <input type="text" id="search-input" name="search" placeholder="Search recipes by title, ingredients, or category..." value="{{searchQuery}}">
                {{#if searchQuery}}
                    <a href="/recipes{{#if categoryFilter}}?category={{categoryFilter}}{{/if}}" class="search-clear-btn" title="Clear search" aria-label="Clear search">✕</a>
                {{/if}}
            </div>
            <button type="submit" class="btn btn-primary" style="border-radius: 30px; padding: 0.75rem 1.35rem;">Search</button>
        </form>
    </div>

    {{#if recipes.length}}
        <div class="recipe-grid">
            {{#each recipes}}
                <article class="recipe-card">
                    <div class="recipe-card-body">
                        <h3 class="recipe-title">
                            <a href="/recipes/{{#if this.recipeId}}{{this.recipeId}}{{else}}{{this.id}}{{/if}}">{{this.title}}</a>
                        </h3>
                        <p class="recipe-author">
                            By <a href="/users/{{#if this.userId}}{{this.userId}}{{else}}{{this.user_id}}{{/if}}">{{#if this.authorName}}{{this.authorName}}{{else}}{{this.username}}{{/if}}</a>
                        </p>
                        {{#if this.description}}
                            <p class="recipe-description">{{this.description}}</p>
                        {{/if}}
                        <div class="recipe-meta">
                            <div class="recipe-meta-badges">
                                {{#if this.prepTime}}
                                    <span>⏱ {{this.prepTime}}m prep</span>
                                {{else if this.prep_time}}
                                    <span>⏱ {{this.prep_time}}m prep</span>
                                {{/if}}
                                {{#if this.cooktime}}
                                    <span>🕒 {{this.cooktime}}m cook</span>
                                {{else if this.cook_time}}
                                    <span>🕒 {{this.cook_time}}m cook</span>
                                {{/if}}
                                {{#if this.servings}}
                                    <span>🍽 {{this.servings}} servings</span>
                                {{/if}}
                            </div>
                        </div>
                    </div>
                    <div class="recipe-card-footer">
                        {{#if ../user}}
                            <button type="button" class="btn-link favorite-btn {{#if this.isFavorite}}favorited{{else if this.isFavorited}}favorited{{/if}}" data-recipe-id="{{#if this.recipeId}}{{this.recipeId}}{{else}}{{this.id}}{{/if}}" style="font-size: 1.1rem; padding: 0.1rem 0.35rem; line-height: 1; cursor: pointer; background: none; border: none;" title="{{#if this.isFavorite}}Unfavorite this recipe{{else if this.isFavorited}}Unfavorite this recipe{{else}}Favorite this recipe{{/if}}">
                                <span class="heart-icon">{{#if this.isFavorite}}❤️{{else if this.isFavorited}}❤️{{else}}🤍{{/if}}</span>
                                <span class="favorite-count">{{#if this.favCount}}{{this.favCount}}{{else}}0{{/if}}</span>
                            </button>
                        {{else}}
                            <span class="favorites-display">
                                <span class="heart-icon">❤️</span>
                                <span class="favorite-count">{{#if this.favCount}}{{this.favCount}}{{else}}0{{/if}}</span>
                            </span>
                        {{/if}}
                        <div class="card-footer-actions">
                            {{#if this.canEdit}}
                                <a href="/recipes/{{#if this.recipeId}}{{this.recipeId}}{{else}}{{this.id}}{{/if}}/edit" class="btn-text btn-text-edit">✏️ Edit</a>
                            {{/if}}
                            <a href="/recipes/{{#if this.recipeId}}{{this.recipeId}}{{else}}{{this.id}}{{/if}}" class="btn-text">View Recipe &rarr;</a>
                        </div>
                    </div>
                </article>
            {{/each}}
        </div>
    {{else}}
        <div class="empty-state">
            <p>No recipes found{{#if searchQuery}} matching "{{searchQuery}}"{{/if}}{{#if categoryFilter}} in category "{{categoryFilter}}"{{/if}}.</p>
            {{#if searchQuery}}
                <a href="/recipes" class="btn btn-secondary">Clear Filters</a>
            {{else if categoryFilter}}
                <a href="/recipes" class="btn btn-secondary">Clear Filters</a>
            {{else}}
                {{#if user}}
                    <a href="/recipes/new" class="btn btn-primary">Share the First Recipe</a>
                {{else}}
                    <a href="/register" class="btn btn-primary">Sign up to Share Recipes</a>
                {{/if}}
            {{/if}}
        </div>
    {{/if}}
</div>
