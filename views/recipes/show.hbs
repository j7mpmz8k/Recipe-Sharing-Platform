<div class="recipe-detail-container">
    <!-- Header Card -->
    <header class="recipe-header-card">
        <div class="section-header">
            <div>
                <h1>{{recipe.title}}</h1>
                <div class="author-badge">
                    <span>By <a href="/users/{{#if recipe.userId}}{{recipe.userId}}{{else}}{{recipe.user_id}}{{/if}}">{{#if recipe.authorName}}{{recipe.authorName}}{{else}}{{recipe.username}}{{/if}}</a></span>
                    <span class="text-muted">• {{recipe.createdAt}}</span>
                    {{#if recipe.isUpdated}}
                        <span class="text-muted">(Updated {{recipe.updatedAt}})</span>
                    {{/if}}
                </div>
            </div>

            <!-- Action buttons for recipe owner -->
            {{#if recipe.canEdit}}
                <div class="recipe-owner-actions">
                    <a href="/recipes/{{#if recipe.recipeId}}{{recipe.recipeId}}{{else}}{{recipe.id}}{{/if}}/edit" class="btn btn-secondary btn-sm">✏️ Edit</a>
                </div>
            {{/if}}
        </div>

        {{#if recipe.description}}
            <p class="recipe-description" style="font-size: 1.1rem; margin: 1rem 0;">{{recipe.description}}</p>
        {{/if}}

        <div class="recipe-header-meta">
            <div class="recipe-meta">
                {{#if recipe.prepTime}}
                    <span>⏱ Prep: {{recipe.prepTime}} min</span>
                {{else if recipe.prep_time}}
                    <span>⏱ Prep: {{recipe.prep_time}} min</span>
                {{/if}}
                {{#if recipe.cooktime}}
                    <span>🕒 Cook: {{recipe.cooktime}} min</span>
                {{else if recipe.cook_time}}
                    <span>🕒 Cook: {{recipe.cook_time}} min</span>
                {{/if}}
                {{#if recipe.servings}}
                    <span>🍽 Servings: {{recipe.servings}}</span>
                {{/if}}
            </div>

            <!-- Favorite Button -->
            <div class="favorite-section">
                {{#if user}}
                    <button type="button" class="btn btn-secondary btn-sm favorite-btn {{#if isFavorited}}favorited{{else if recipe.isFavorite}}favorited{{/if}}" data-recipe-id="{{#if recipe.recipeId}}{{recipe.recipeId}}{{else}}{{recipe.id}}{{/if}}" title="{{#if isFavorited}}Unfavorite this recipe{{else if recipe.isFavorite}}Unfavorite this recipe{{else}}Favorite this recipe{{/if}}">
                        <span class="heart-icon">{{#if isFavorited}}❤️{{else if recipe.isFavorite}}❤️{{else}}🤍{{/if}}</span>
                        <span class="favorite-text">{{#if isFavorited}}Favorited{{else}}Favorite{{/if}}</span>
                        (<span class="favorite-count">{{#if recipe.favCount}}{{recipe.favCount}}{{else}}0{{/if}}</span>)
                    </button>
                {{else}}
                    <span class="favorites-badge">❤️ {{#if recipe.favCount}}{{recipe.favCount}}{{else}}0{{/if}} favorites</span>
                {{/if}}
            </div>
        </div>
    </header>

    <!-- Content Grid: Ingredients & Instructions -->
    <div class="recipe-content-grid">
        <section class="ingredients-card">
            <h2>Ingredients</h2>
            <p class="form-hint">Check off items as you cook:</p>
            <ul class="ingredients-list">
                {{#if recipe.ingredientsList}}
                    {{#each recipe.ingredientsList}}
                        <li>
                            <label class="ingredient-item">
                                <input type="checkbox">
                                <span>{{this}}</span>
                            </label>
                        </li>
                    {{/each}}
                {{else}}
                    <div class="instructions-text">{{recipe.ingredients}}</div>
                {{/if}}
            </ul>
        </section>

        <section class="instructions-card">
            <h2>Instructions</h2>
            <div class="instructions-text">{{recipe.instructions}}</div>
        </section>
    </div>
</div>
