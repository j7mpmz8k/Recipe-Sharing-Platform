<div class="recipe-detail-container">
    <!-- Header Card -->
    <header class="recipe-header-card">
        <div class="section-header">
            <div>
                <h1>{{recipe.title}}</h1>
                <div class="author-badge">
                    <span>By <a href="/users/{{#if recipe.userId}}{{recipe.userId}}{{else}}{{recipe.user_id}}{{/if}}">{{recipe.username}}</a></span>
                    <span class="text-muted">• {{recipe.createdAt}}</span>
                    {{#if recipe.isUpdated}}
                        <span class="text-muted">(Updated {{recipe.updatedAt}})</span>
                    {{/if}}
                </div>
            </div>

            <!-- Action buttons for recipe owner -->
            {{#if recipe.canEdit}}
                <div class="recipe-owner-actions">
                    <a href="/recipes/{{#if recipe.recipeId}}{{recipe.recipeId}}{{else}}{{recipe.id}}{{/if}}/edit" class="btn btn-secondary btn-sm">✏️ Edit</a>
                </div>
            {{/if}}
        </div>

        {{#if recipe.description}}
            <p class="recipe-description" style="font-size: 1.1rem; margin: 1rem 0;">{{recipe.description}}</p>
        {{/if}}

        <div class="recipe-header-meta">
            <div class="recipe-meta">
                {{#if recipe.prepTime}}
                    <span>⏱ Prep: {{recipe.prepTime}} min</span>
                {{else if recipe.prep_time}}
                    <span>⏱ Prep: {{recipe.prep_time}} min</span>
                {{/if}}
                {{#if recipe.cooktime}}
                    <span>🍳 Cook: {{recipe.cooktime}} min</span>
                {{else if recipe.cook_time}}
                    <span>🍳 Cook: {{recipe.cook_time}} min</span>
                {{/if}}
                {{#if recipe.servings}}
                    <span>🍽 Servings: {{recipe.servings}}</span>
                {{/if}}
            </div>

            <!-- Favorite Button -->
            <div class="favorite-section">
                {{#if user}}
                    <button type="button" class="btn btn-secondary btn-sm favorite-btn" data-recipe-id="{{#if recipe.recipeId}}{{recipe.recipeId}}{{else}}{{recipe.id}}{{/if}}">
                        <span class="heart-icon">{{#if isFavorited}}❤️{{else}}🤍{{/if}}</span>
                        <span class="favorite-text">{{#if isFavorited}}Favorited{{else}}Favorite{{/if}}</span>
                        (<span class="favorite-count">{{#if favoritesCount}}{{favoritesCount}}{{else}}0{{/if}}</span>)
                    </button>
                {{else}}
                    <span class="favorites-badge">❤️ {{#if favoritesCount}}{{favoritesCount}}{{else}}0{{/if}} favorites</span>
                {{/if}}
            </div>
        </div>
    </header>

    <!-- Content Grid: Ingredients & Instructions -->
    <div class="recipe-content-grid">
        <section class="ingredients-card">
            <h2>Ingredients</h2>
            <p class="form-hint">Check off items as you cook:</p>
            <ul class="ingredients-list">
                {{#if recipe.ingredientsList}}
                    {{#each recipe.ingredientsList}}
                        <li>
                            <label class="ingredient-item">
                                <input type="checkbox">
                                <span>{{this}}</span>
                            </label>
                        </li>
                    {{/each}}
                {{else}}
                    <div class="instructions-text">{{recipe.ingredients}}</div>
                {{/if}}
            </ul>
        </section>

        <section class="instructions-card">
            <h2>Instructions</h2>
            <div class="instructions-text">{{recipe.instructions}}</div>
        </section>
    </div>

    <!-- Rating Section -->
    <section class="recipe-header-card rating-section">
        <h3>Recipe Rating</h3>
        <p>
            Average Rating: <strong>★ {{#if avgRating}}{{avgRating}}{{else}}Unrated{{/if}}</strong>
            {{#if ratingCount}}({{ratingCount}} ratings){{/if}}
        </p>

        {{#if user}}
            <form action="/recipes/{{#if recipe.recipeId}}{{recipe.recipeId}}{{else}}{{recipe.id}}{{/if}}/rate" method="POST" class="rating-form">
                <p>{{#if userRating}}Your rating: <strong>★ {{userRating}}/5</strong> (select a star to change):{{else}}Rate this recipe:{{/if}}</p>
                <div class="star-rating">
                    <input type="radio" id="star5" name="rating" value="5" required>
                    <label for="star5" title="5 stars">★</label>
                    <input type="radio" id="star4" name="rating" value="4">
                    <label for="star4" title="4 stars">★</label>
                    <input type="radio" id="star3" name="rating" value="3">
                    <label for="star3" title="3 stars">★</label>
                    <input type="radio" id="star2" name="rating" value="2">
                    <label for="star2" title="2 stars">★</label>
                    <input type="radio" id="star1" name="rating" value="1">
                    <label for="star1" title="1 star">★</label>
                </div>
                <button type="submit" class="btn btn-primary btn-sm" style="margin-left: 1rem;">Submit Rating</button>
            </form>
        {{else}}
            <p><a href="/login">Log in</a> to rate or favorite this recipe.</p>
        {{/if}}
    </section>
</div>
