# ==============================================================================
# Recipe Sharing Platform - Environment Configuration Example
# ==============================================================================

# Application Port (default: 3000)
PORT=3000

# Automatically run database migrations on container start (true / false)
RUN_MIGRATIONS=true

# Database Connection
# - In Production Docker: DB_HOST=db, DB_USER=postgres
# - In Local Development: DB_HOST=localhost, DB_USER=admin
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=your_secure_password_here
DB_NAME=recipe_db

# ==============================================================================
# Remote Production Database Sync (Used by 'npm run db:pull' on local laptop)
# ==============================================================================
PROD_SSH_HOST=super_admin@your-production-server-ip
PROD_SSH_PORT=48222
PROD_DB_NAME=recipe_db
PROD_DB_USER=postgres
