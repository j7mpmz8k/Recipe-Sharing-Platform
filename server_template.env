# ==============================================================================
# Recipe Sharing Platform - Server / Production Environment Configuration
# ==============================================================================

# Environment mode ('production' enables secure HTTPS cookies)
NODE_ENV=production

# Application HTTP Port
PORT=3000

# Automatically run database migrations on container start (true / false)
# Read by docker-entrypoint.sh
RUN_MIGRATIONS=true

# Production Database Connection
# - When using Docker Compose: DB_HOST=db, DB_USER=postgres
# - When using local system Postgres: DB_HOST=/run/postgresql or localhost
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
# Wrap password in quotes if it contains special characters (&, #, $, !)
DB_PASSWORD="your_production_db_password_here"
DB_NAME=recipe_db
