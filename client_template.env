# ==============================================================================
# Recipe Sharing Platform - Local Client / Developer Workstation Configuration
# ==============================================================================

# Local environment mode (allows cookies over plain HTTP localhost)
NODE_ENV=development

# Local Development Port
PORT=3000

# Migrations setting (run manually with 'npm run migrate' during local dev)
RUN_MIGRATIONS=false

# Local Database Connection
# - Linux Unix Socket: DB_HOST=/run/postgresql, DB_USER=admin
# - Local TCP Loopback: DB_HOST=localhost, DB_PORT=5432, DB_USER=admin
DB_HOST=/run/postgresql
DB_PORT=5432
DB_USER=admin
# Wrap password in quotes if it contains special characters (&, #, $, !)
DB_PASSWORD="your_local_db_password_here"
DB_NAME=recipe_db

# ==============================================================================
# Remote Production Database Sync ('npm run db:pull')
# Streams production database dump directly into your local database over SSH.
# Note: Requires SSH key authentication configured with your remote server.
# ==============================================================================
PROD_SSH_HOST=super_admin@your-production-server-ip
PROD_SSH_PORT=48222
PROD_DB_NAME=recipe_db
PROD_DB_USER=postgres
